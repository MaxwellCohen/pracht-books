# Postgres connection string. Leave blank to run against the generated preview
# catalog instead of a database — the e2e suite does exactly that.
POSTGRES_URL=

# Optional. Artificial latency for server queries, in milliseconds.
# Useful as a default when the sidebar API delay slider is Off.
API_DELAY_MS=

# Point the Playwright suite at an already-running dev server.
PLAYWRIGHT_BASE_URL=

# Trusted origin for the local image optimizer. Matches `pracht dev`.
PRACHT_ORIGIN=http://localhost:3000

# Seed knobs (npm run db:seed-authors / npm run db:seed-books). Paths default to the
# newline-delimited dumps under src/lib/db; the totals cap how much gets imported.
AUTHORS_DATA_PATH=
BOOKS_DATA_PATH=
AUTHORS_CHECKPOINT_PATH=
BOOKS_CHECKPOINT_PATH=
TOTAL_AUTHORS=
TOTAL_BOOKS=
