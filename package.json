{
  "name": "pracht-books",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pracht build",
    "dev": "pracht dev",
    "typecheck": "tsc --noEmit",
    "typegen": "pracht typegen",
    "deploy": "pracht build && wrangler deploy",
    "preview": "pracht preview",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run db:seed-authors && npm run db:seed-books",
    "db:seed-authors": "tsx src/lib/db/seed-authors.ts",
    "db:seed-books": "tsx src/lib/db/seed-books.ts",
    "db:seed-thumbhash": "tsx src/lib/db/seed-thumbhash.ts",
    "preview:cloudflare": "CLOUDFLARE=1 pracht build && wrangler dev",
    "deploy:cloudflare": "CLOUDFLARE=1 pracht build && wrangler deploy",
    "deploy:netlify": "NETLIFY=1 pracht build && npx --yes netlify deploy --prod --no-build",
    "deploy:vercel": "pracht build && npx --yes vercel deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/blobs": "^11.1.0",
    "@pracht/adapter-cloudflare": "^0.7.4",
    "@pracht/core": "^0.18.0",
    "@pracht/image": "^0.4.1",
    "@vercel/functions": "^3.9.8",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@pracht/adapter-netlify": "^0.2.4",
    "@pracht/adapter-vercel": "^0.3.4",
    "@pracht/cli": "^1.14.0",
    "@pracht/vite-plugin": "^0.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "p-limit": "^7.3.3",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
