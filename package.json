{
  "name": "pract-books",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pracht build",
    "dev": "pracht dev",
    "typecheck": "tsc --noEmit",
    "typegen": "pracht typegen",
    "deploy": "pracht build && wrangler deploy",
    "preview": "pracht preview",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run db:seed-authors && npm run db:seed-books",
    "db:seed-authors": "tsx src/lib/db/seed-authors.ts",
    "db:seed-books": "tsx src/lib/db/seed-books.ts",
    "db:seed-thumbhash": "tsx src/lib/db/seed-thumbhash.ts",
    "preview:cloudflare": "CLOUDFLARE=1 pracht build && npx --yes wrangler@4.131.2 dev",
    "deploy:cloudflare": "CLOUDFLARE=1 pracht build && npx --yes wrangler@4.131.2 deploy",
    "deploy:netlify": "NETLIFY=1 pracht build && npx --yes netlify deploy --prod --no-build",
    "deploy:vercel": "pracht build && npx --yes vercel deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pracht/adapter-cloudflare": "^0.7.3",
    "@pracht/core": "^0.17.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@pracht/adapter-netlify": "^0.2.3",
    "@pracht/adapter-vercel": "^0.3.3",
    "@pracht/cli": "^1.13.0",
    "@pracht/vite-plugin": "^0.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "p-limit": "^7.3.1",
    "preact": "^10.26.9",
    "preact-render-to-string": "^6.5.13",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.81.0"
  }
}
